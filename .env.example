# ---------- Required ----------
MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/manik-portfolio"
# Optional. The app asks Google and Cloudflare DNS for the Atlas address, because many ISP routers
# refuse it ("querySrv ECONNREFUSED"). Set to "off" to use the system DNS instead.
# MONGODB_DNS="8.8.8.8,1.1.1.1"
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
# Your live domain, no trailing slash. Used for payment callbacks, sitemap and SEO.
NEXT_PUBLIC_SITE_URL="https://manikhossain.in"

# First admin login. On the first successful login this account is saved to the
# database; change the password afterwards from Admin > Account.
ADMIN_EMAIL="admin@manikhossain.in"
ADMIN_PASSWORD="change-me-now"

# ---------- Cloudinary: REQUIRED on Vercel (its disk is read-only). Optional on a VPS. ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Email (thank-you mails, order mails, invoices, alerts) ----------
# Easiest: Resend (resend.com). Verify your domain there, then set:
RESEND_API_KEY=""
MAIL_FROM="hello@manikhossain.in"
# ...or use SMTP instead (Gmail app password, Zoho, Hostinger mail, etc.):
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="admin@manikhossain.in"

# ---------- Optional: SSLCommerz (cards, bKash, Nagad, Rocket, net banking in one gateway) ----------
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWORD=""
SSLCZ_SANDBOX="true"

# ---------- Optional: PayPal automatic checkout ----------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_SANDBOX="true"

# ---------- Optional: AI answers in the built-in chat ----------
# Pick the provider in Admin > SEO and integrations > Chat. Only the key for that provider is needed.
# Google Gemini has a free tier (key from aistudio.google.com, no card needed).
GEMINI_API_KEY=""
# Groq: free, very fast (console.groq.com/keys). OpenRouter: free models (openrouter.ai/keys).
# The AI writer uses every free key you add and switches automatically if one is busy.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# ChatGPT API needs prepaid credit at platform.openai.com (a ChatGPT Plus plan does not include API use).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Daily subscription check (reminders and switching ended plans off). Any long random text. Add the same value in Vercel.
CRON_SECRET=""
